# Supabase — get these from your project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, used for document processing jobs. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Your own user id — grants access to /admin. Sign up first, then copy your
# id from the bottom of /profile (or Supabase → Authentication → Users).
ADMIN_USER_ID=your-user-uuid
